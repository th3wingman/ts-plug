// ts-multinet config — parsed as HuJSON: // comments and trailing commas are fine.
//
// A fresh install starts EMPTY and is managed live from the web UI
// (http://127.0.0.1:8123) or the CLI — no file editing, no restarts:
//
//   sudo ts-multinet add <name>        # tailnet appears below, cidr/tun auto-picked
//   sudo ts-multinet login <name>      # once per tailnet; prints a browser URL
//   sudo ts-multinet peers <name>      # short names of that tailnet's peers
//   sudo ts-multinet select <name> <peer>...   # expose them (or use the web UI)
//
// The daemon owns this file: add/remove/select/forget/allow-all/domain
// (CLI and web UI) patch it in place and your comments survive. Manual edits
// work too — just `sudo ts-multinet reload` afterwards; only globals
// (mtu, dns_listen, upstream_dns, state_dir, hosts_file, ui_listen)
// need a service restart.
//
// Auth keys are optional (tagged/automation nodes): "auth_key": "tskey-auth-…"
// on a tailnet enrolls it without a browser — the key lives in this file and
// is never shown again (config output redacts it). Ambient TS_AUTHKEY env
// vars stay rejected. Delete purges local keys and settings; Disable keeps them.
{
  // matches StateDirectory= in the systemd unit; the bare default is ".state"
  // in the working directory — keep this line when running as a service
  "state_dir": "/var/lib/ts-multinet",

  // everything else is optional — defaults shown:
  // "mtu": 1280,
  // "dns_listen": "127.0.0.1:53",
  // "upstream_dns": "1.1.1.1",        // non-tailnet names; default: first nameserver in /etc/resolv.conf
  // "hosts_file": "/etc/hosts",
  // "ui_listen": "127.0.0.1:8123",    // web UI (localhost-only, no auth): dashboard, peer selection, logins

  "tailnets": [
    // nothing here yet — tailnets appear as you add them (UI or `add`).
    // A hand-written entry, if you prefer files, looks like:
    //
    // {
    //   "name": "skynet",             // any label you like — identity only (state dir, commands);
    //   //                            // a DNS-safe domain and node hostname are generated from it
    //   "cidr": "198.18.1.0/24",        // synthetic range, unique per tailnet, out of 198.18.0.0/15;
    //   //                               // next tailnet takes 198.18.2.0/24, then .3.0/24, ...
    //   "tun": "tsm0",                  // TUN device name, <= 15 chars (kernel limit)
    //
    //   // optional:
    //   // "suffix": "example.ts.net",  // MagicDNS suffix; auto-detected when omitted
    //   // "domain": "skynet",          // friendly DNS suffix (default: slug of the name);
    //   //                              // my-server.skynet and my-server.example.ts.net both resolve
    //   // "hostname": "xps13",         // node name in this tailnet (default: ts-multinet-<slug>);
    //   // "enabled": false,            // default true; false skips this tailnet
    //   // "report_posture": true,      // default false; opt in to hardware identity reporting
    //   //                              // for Fleet/CrowdStrike matching in this tailnet only
    //   // "allow_all": true,           // select every peer instead of listing resources
    //   //                              // (shared Mullvad exit nodes are never selectable)
    //   // "resources": ["host1", "host2"],  // short names exactly as `peers` shows them;
    //   //                                   // usually managed via `select`/`forget` or the web UI
    //   // "auto_select": ["tag:infra", "svc:prod-*", "tcp:3306"],  // select without listing:
    //   //                              // tag:<acl-tag> grabs peers carrying the tag,
    //   //                              // svc:<glob> grabs services by label,
    //   //                              // tcp:<port> grabs services advertising that port;
    //   //                              // matches land live as tags/services change
    //   //                              // (`ts-multinet auto <name> ...` manages them)
    //   // "locked": ["jumpbox"],         // pinned essentials ⊆ resources: survive clear-all,
    //   //                              // refuse forget, and block disabling/removing the
    //   //                              // tailnet — jumpboxes, logging, metrics; unlock to release
    //   // "native_dns": true,           // also list the native MagicDNS name (host.<suffix>)
    //   //                               // on the /etc/hosts line, so shell completion
    //   //                               // offers both spellings; DNS resolves either
    //   //                               // way; default false
    //   // "domain_hosts": true,         // always write /etc/hosts entries as <name>.<domain>;
    //   //                               // default false: the bare name, qualified only when
    //   //                               // another tailnet claims the same name
    //   // "auth_key": "tskey-auth-…",  // tagged-device enrollment — node joins without
    //   //                               // a browser (tag comes from the key);
    //   //                               // stored here, redacted in config output
    // },
  ]
}
