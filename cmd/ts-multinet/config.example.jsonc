// ts-multinet config — parsed as HuJSON: // comments and trailing commas are fine.
//
// Minimal working setup:
//   1. list each tailnet below (name, cidr, tun — all required)
//   2. sudo systemctl restart ts-multinet
//   3. sudo ts-multinet login <name>      # once per tailnet; prints a browser URL
//   4. sudo ts-multinet peers <name>      # short names of that tailnet's peers
//   5. sudo ts-multinet select <name> <peer>...   # expose them (or use the web UI)
//
// The daemon owns this file: select/forget/allow-all/domain (CLI and web UI)
// patch it in place and your comments survive. Manual edits work too — just
// `sudo ts-multinet reload` afterwards.
//
// No authkeys: node state under state_dir persists, so login is once, in the
// browser, forever.
{
  // matches StateDirectory= in the systemd unit; the bare default is ".state"
  // in the working directory — keep this line when running as a service
  "state_dir": "/var/lib/ts-multinet",

  // everything else is optional — defaults shown:
  // "mtu": 1280,
  // "dns_listen": "127.0.0.1:53",
  // "upstream_dns": "1.1.1.1",        // non-tailnet names; default: first nameserver in /etc/resolv.conf
  // "hosts_file": "/etc/hosts",
  // "ui_listen": "127.0.0.1:8123",    // web UI (localhost-only, no auth): dashboard, peer selection, logins

  "tailnets": [
    {
      // short id — used by `login`/`peers`/`reload <name>` and the state dir
      "name": "example",

      // synthetic range for this tailnet: unique per tailnet, out of
      // 198.18.0.0/15 (benchmark space, never real traffic).
      // Next tailnet takes 198.18.2.0/24, then .3.0/24, ...
      "cidr": "198.18.1.0/24",

      // TUN device name, <= 15 chars (kernel limit)
      "tun": "tsm0",

      // optional per tailnet:
      // "suffix": "example.ts.net",          // MagicDNS suffix; auto-detected when omitted
      // "domain": "example",                 // friendly DNS suffix (default: the tailnet name);
      //                                          // my-server.example and my-server.example.ts.net both resolve
      // "enabled": false,                    // default true; false skips this tailnet
      // "allow_all": true,                   // select every peer instead of listing resources
      //                                      // (shared Mullvad exit nodes are never selectable)
      // "resources": ["host1", "host2"],     // short names exactly as `peers` shows them;
      //                                      // usually managed via `select`/`forget` or the web UI
    },
  ]
}
